# Core daemon
MY_AGENT_HOST=127.0.0.1
MY_AGENT_PORT=7437
MY_AGENT_RUNS_DIR=runs

# Logging
MY_AGENT_LOG_LEVEL=INFO
MY_AGENT_LOG_FORMAT=text
MY_AGENT_LOG_FILE=~/.my-agent/logs/core.log

# LLM
MY_AGENT_LLM_DEFAULT_MODEL=deepseek-v4-pro

# Trace
MY_AGENT_TRACE_ENABLED=true
MY_AGENT_TRACE_FILE=~/.my-agent/traces/daemon.jsonl
MY_AGENT_TRACE_INCLUDE_LLM_PAYLOAD=true

# Agent loop
MY_AGENT_MAX_STEPS=20

# Context compaction
MY_AGENT_COMPACT_ENABLED=true
MY_AGENT_COMPACT_TOKEN_THRESHOLD=120000
MY_AGENT_COMPACT_TOOL_RESULT_LIMIT=8000
MY_AGENT_COMPACT_TOOL_RESULT_KEEP=4000

# Disabled by default. Set to 0.8 to compact after a provider reports 80% context usage.
MY_AGENT_COMPACT_CONTEXT_RATIO=0
